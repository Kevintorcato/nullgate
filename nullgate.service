[Unit]
Description=Nullgate - auditoria WiFi de bolso
After=network.target

[Service]
Type=simple
# roda com root (precisa mexer nas interfaces de radio)
User=root
WorkingDirectory=/opt/nullgate/server
Environment=NULLGATE_RADIO=wlan1
ExecStart=/usr/bin/python3 /opt/nullgate/server/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
