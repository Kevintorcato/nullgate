{
  "app": "Nullgate",
  "version": "0.9.20",
  "sections": [
    {
      "id": "wifi",
      "title": "WiFi",
      "icon": "wifi",
      "kind": "builtin",
      "note": "Scan, captura de handshake e export. Audite apenas redes suas."
    },
    {
      "id": "sistema",
      "title": "Sistema",
      "icon": "cpu",
      "kind": "builtin"
    },
    {
      "id": "rede",
      "title": "Rede",
      "icon": "network",
      "kind": "actions",
      "actions": [
        {
          "id": "nmap_quick",
          "nome": "Nmap quick scan",
          "desc": "Varredura rapida de portas num alvo",
          "cmd": "nmap -T4 -F {alvo}",
          "campos": [
            {"nome": "alvo", "label": "IP ou faixa", "placeholder": "10.6.1.0/24"}
          ]
        },
        {
          "id": "hosts_lan",
          "nome": "Hosts na LAN",
          "desc": "Descobre aparelhos na rede",
          "cmd": "nmap -sn {alvo}",
          "campos": [
            {"nome": "alvo", "label": "Faixa", "placeholder": "10.6.1.0/24"}
          ]
        },
        {
          "id": "ping",
          "nome": "Ping",
          "desc": "Testa se um host responde",
          "cmd": "ping -c 4 -W 2 {alvo}",
          "campos": [
            {"nome": "alvo", "label": "Host", "placeholder": "10.6.1.1"}
          ]
        },
        {
          "id": "adb_scan",
          "nome": "Scan ADB (5555)",
          "desc": "Acha aparelhos com ADB aberto na rede (Android/tablets)",
          "cmd": "nmap -p 5555 --open -T4 {alvo}",
          "campos": [
            {"nome": "alvo", "label": "Faixa da rede", "placeholder": "10.6.1.0/24"}
          ]
        },
        {
          "id": "scan_completo",
          "nome": "Scan completo (rapido)",
          "desc": "Descobre hosts, portas abertas (top 1000), servico e chute de SO - so dos que responderam",
          "cmd": "nmap -T4 --min-rate 500 -sV --version-intensity 2 -O --osscan-guess --open {alvo}",
          "timeout": 300,
          "campos": [
            {"nome": "alvo", "label": "Faixa ou IP", "placeholder": "10.6.1.0/24"}
          ]
        }
      ]
    }
  ]
}
